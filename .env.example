# Database
DATABASE_URL=postgresql+asyncpg://resume_agent:resume_agent_dev@localhost:5432/resume_agent

# Vector DB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=resume_agent_

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM APIs
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://router.c.yiling.top/v1

# Use Claude for resume tailoring: set an Anthropic key + LLM_PROVIDER=anthropic.
# Get a key at https://console.anthropic.com — this swaps the tailoring agent's
# "brain" to Claude with no other code changes.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# LLM_PROVIDER=anthropic

# Default LLM models
DEFAULT_TAILOR_MODEL=gpt-5.5
DEFAULT_PARSER_MODEL=gpt-5.5
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# Application
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
MAX_DAILY_APPLICATIONS=20
MAX_DAILY_EMAILS=10

# Job Discovery - Adzuna
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Real browser auto-apply (Playwright). Fill + screenshot, never clicks Submit.
ENABLE_BROWSER_FILL_PAUSE=true
# true = fill the REAL company ATS page. false = local sandbox fixtures only (dev default).
ALLOW_LIVE_BROWSER_FILL=false
# false = show a real browser window (useful if the ATS needs you to log in first).
BROWSER_HEADLESS=true

# ATS Create Account / Sign In (Phase 4). Do not commit real passwords.
# ATS_DEFAULT_EMAIL=you@example.com
# ATS_DEFAULT_PASSWORD=ChangeMe1!
# Optional password policy (Workday-like defaults)
# ATS_PASSWORD_MIN_LENGTH=8
# ATS_PASSWORD_REQUIRE_UPPER=true
# ATS_PASSWORD_REQUIRE_LOWER=true
# ATS_PASSWORD_REQUIRE_DIGIT=true
# ATS_PASSWORD_REQUIRE_SPECIAL=true

# Jobright detail URL template for cart → apply navigation
# JOBRIGHT_JOB_URL_TEMPLATE=https://jobright.ai/jobs/info/{intern_job_id}
# Phase 2: true = always open Jobright and click Original Job Post first
CART_APPLY_LIVE_NAV=false
# When live nav is off / scrape miss: still try Playwright once as fallback
CART_APPLY_LIVE_NAV_FALLBACK=true
# Phase 3: live Apply → Autofill with Resume on company ATS (file:// fixtures always ok)
CART_APPLY_LIVE_ENTRY=false

# Job Index ingest tuning
JOB_INDEX_ENABLED=true
JOB_INDEX_INGEST_INTERVAL_MINUTES=30
JOB_INDEX_INGEST_LIMIT=50
JOB_INDEX_HOURS_OLD=168
JOB_INDEX_DEFAULT_LOCATION=
JOB_INDEX_DEFAULT_QUERIES=data analyst,business analyst,analytics,business intelligence analyst,BI analyst,SQL analyst
JOB_INDEX_JOBSPY_SITES=indeed,google
# Set true only on Python 3.11/3.12 venvs — JobSpy crashes on some 3.14 Windows builds.
JOB_INDEX_ENABLE_JOBSPY=false
