{
  "manifest_version": 3,
  "name": "Resume Agent - Jobright Bridge",
  "version": "0.2.4",
  "description": "Jobright -> Tailor / Apply / Outreach, plus ATS form-fill (paused before submit).",
  "permissions": ["storage", "tabs", "activeTab", "windows", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "https://jobright.ai/*",
    "https://*.jobright.ai/*",
    "https://www.jobright.ai/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "file:///*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobright.ai/*",
        "https://*.jobright.ai/*",
        "https://www.jobright.ai/*",
        "http://127.0.0.1:3000/fixtures/jobright-mock.html",
        "http://localhost:3000/fixtures/jobright-mock.html",
        "http://127.0.0.1:3000/fixtures/jobright-realistic-mock.html",
        "http://localhost:3000/fixtures/jobright-realistic-mock.html",
        "file:///*jobright-mock.html",
        "file:///*jobright-realistic-mock.html"
      ],
      "js": ["content/extract.js", "content/fab-diagnostics.js", "content/fab.js", "content/demote.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*"
      ],
      "exclude_matches": [
        "http://127.0.0.1:3000/fixtures/jobright-mock.html",
        "http://localhost:3000/fixtures/jobright-mock.html",
        "http://127.0.0.1:3000/fixtures/jobright-realistic-mock.html",
        "http://localhost:3000/fixtures/jobright-realistic-mock.html"
      ],
      "js": ["content/back_to_jobright.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://*.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*"
      ],
      "js": ["content/form_fill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Resume Agent Bridge",
    "default_popup": "popup/popup.html"
  }
}
