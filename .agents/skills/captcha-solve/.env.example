# captcha-solve / scripts/solve.py
# cp .env.example .env 后填写

CAPTCHA_API_KEY=your-ark-api-key-here
CAPTCHA_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 方舟推理接入点 ep-…（推荐）或模型 ID
CAPTCHA_MODEL=ep-xxxxxxxxxxxxxxxx

CAPTCHA_COORDINATE_SCALE=1000
CAPTCHA_MAX_TOKENS=1024
CAPTCHA_TEMPERATURE=0.1

# 未设 CAPTCHA_API_KEY 时回退：ARK_API_KEY / LOCATE_API_KEY
