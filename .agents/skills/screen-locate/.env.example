# ============================================================
# 屏幕定位 Skill 配置（scripts/locate.py）
# 复制此文件为同目录下的 .env 并填入实际值
# 支持火山引擎 UI-TARS 及任何 OpenAI 兼容 VLM API
# ============================================================

# --- 必填 ---
LOCATE_API_KEY=your-api-key-here

# --- 选填（有默认值）---
# 火山引擎 UI-TARS 默认配置
LOCATE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LOCATE_MODEL=ui-tars-72b

# Thought 部分使用的语言
LOCATE_LANGUAGE=Chinese

# 模型输出坐标的归一化范围（UI-TARS / doubao 为 1000）
LOCATE_COORDINATE_SCALE=1000

# 模型最大输出 token
LOCATE_MAX_TOKENS=512

# ============================================================
# 常见配置示例（取消注释即可切换）
# ============================================================

# --- 火山引擎 UI-TARS（默认）---
# LOCATE_API_KEY=xxx
# LOCATE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LOCATE_MODEL=ui-tars-72b

# --- 其他 OpenAI 兼容 VLM ---
# LOCATE_API_KEY=sk-xxx
# LOCATE_BASE_URL=https://api.openai.com/v1
# LOCATE_MODEL=gpt-4o
