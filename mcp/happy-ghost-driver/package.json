{
  "name": "ghost-driver-mcp",
  "version": "0.0.1",
  "type": "module",
  "description": "MCP-based browser automation foundation: attach real Chrome via CDP, physical human-like input via ghost-cursor, side-channel capture to SQLite.",
  "bin": {
    "ghost-driver-mcp": "dist/mcp/run-server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist data/*.db",
    "smoke": "node dist/smoke.js",
    "dev:sniff": "node dist/collect/run-sniffer.js",
    "dev:mcp": "node dist/mcp/run-server.js",
    "dev:chrome": "bash scripts/launch-chrome.sh",
    "dev:env:start": "bash scripts/dev-env.sh start",
    "dev:env:stop": "bash scripts/dev-env.sh stop",
    "dev:env:status": "bash scripts/dev-env.sh status",
    "dev:env:logs": "bash scripts/dev-env.sh logs",
    "test": "node --test 'test/unit/**/*.test.mjs'",
    "test:integration": "node test/integration/mcp-stdio.test.mjs",
    "test:e2e": "node test/e2e/closed-loop.mjs",
    "test:e2e:a11y-clip": "node test/e2e/a11y-scroll-clip.mjs",
    "test:e2e:cursor-scroll-sync": "node test/e2e/cursor-scroll-sync.mjs",
    "test:e2e:a11y-clickable-href": "node test/e2e/a11y-clickable-div-and-href.mjs",
    "test:e2e:jd": "node test/e2e/jd-screen-locate.mjs",
    "test:e2e:close-tab": "node test/e2e/close-tab.mjs",
    "config:init": "npm run build && node dist/config/encrypt-cli.js init",
    "config:encrypt": "npm run build && node dist/config/encrypt-cli.js encrypt"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.3.0",
    "ghost-cursor": "^1.3.0",
    "mysql2": "^3.22.5",
    "playwright-core": "^1.48.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
