# ── Resume Agent Docker 部署配置 ──────────────────────────────
# 复制为 .env.docker 并填入真实值，然后: ./deploy.sh run

# ── 宿主机端口映射 ───────────────────────────────────────────
HOST_FRONTEND_PORT=3000
HOST_BACKEND_PORT=8000

# ── 安全 ──────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string

# ── LLM ──────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://router.c.yiling.top/v1

# ── 模型 (可选，留空用代码默认值) ────────────────────────────
DEFAULT_TAILOR_MODEL=gpt-5.5
DEFAULT_PARSER_MODEL=gpt-5.5

# ── 应用 ──────────────────────────────────────────────────────
APP_ENV=production
CORS_ORIGINS=*

# ── 限流 (可选) ───────────────────────────────────────────────
MAX_DAILY_APPLICATIONS=20
MAX_DAILY_EMAILS=10

# ── 提交策略 (可选) ───────────────────────────────────────────
ENABLE_AUTO_SUBMIT=false
ENABLE_BROWSER_AUTOMATION=false
