{
  "mcpServers": {
    "ghost-driver-mcp": {
      "command": "/bin/bash",
      "args": ["mcp/happy-ghost-driver/scripts/run-mcp-stdio.sh"],
      "env": {
        "NODE_BIN": "${userHome}/.local/node/bin/node",
        "CDP_ENDPOINT": "http://127.0.0.1:9222",
        "STORE_BACKEND": "sqlite",
        "DB_PATH": "mcp/happy-ghost-driver/data/intercepted.db",
        "COOLDOWN_MIN_MS": "1000",
        "COOLDOWN_MAX_MS": "3000",
        "PACING_ENABLED": "1"
      }
    }
  }
}
